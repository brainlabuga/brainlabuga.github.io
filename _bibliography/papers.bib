@article{herzberg_resource_2025,
	title = {Resource {Thresholds} for {Parenting} to {Enhance} {Child} {Cognition}},
	issn = {2168-6203},
	url = {https://doi.org/10.1001/jamapediatrics.2025.3667},
	doi = {10.1001/jamapediatrics.2025.3667},
	abstract = {Socioeconomic status is a major predictor of physical and mental health in the United States, an effect due, in part, to the environmental conditions associated with the experience of poverty. Often, these environmental conditions do not allow adequate support for caregivers, which negatively impacts the parenting that they can provide. Strained resources and limited opportunities are a serious problem as supportive parenting robustly predicts greater cognitive ability and lower psychopathology risk in childhood. What is not yet known, and important for public policy, is whether there is a threshold of family income that provides caregivers the minimal necessary resources to provide supportive parenting foundational to healthy child development in the first years of life. Research from our group in the sociodemographically diverse Early Life Adversity and Biological Embedding (eLABE) study has taken a step toward this goal, establishing links between prenatal social disadvantage, supportive parenting, and cognitive outcomes at age 2 years. In this work, supportive parenting was a composite variable defined using behavioral codes of sensitivity (eg, responsiveness to cues) and positive regard (eg, positive affect). Critically, while supportive parenting at age 1 year was associated with improved cognition scores 1 year later, this association was only evident in children from lower-disadvantage families. In follow-up eLABE analyses using family income to needs ratio (INR), we investigated the degree to which increasing material resources were associated with supportive parenting and cognitive development. On average, increasing INR was associated with more supportive parenting until family income approached 400\% of the federal poverty line (Figure, A). While there was variance in supportive parenting at low family income, around 300\% of the federal poverty line, essentially all families were able to engage in the level of supportive parenting associated with improved cognition (Figure). These findings suggest that increasing family income in very low-resourced families to between 200\% and 400\% of the federal poverty line could result in more supportive parenting opportunities and enhanced parenting effects on cognition. While these analyses suggest increasing family income up to 4 times the poverty line is associated with more supportive parenting, which is linked with improved cognition scores 1 year later, better parenting is associated with better cognition on average only in higher-income families. Though variability exists in the level of supportive parenting in low-income families, with some exhibiting supportive parenting equivalent to those from higher-income families, supportive parenting may not be associated with better cognition until families also have adequate material resources. It may also be that improvements in cognition associated with supportive parenting are protective against psychopathology symptoms, further emphasizing the need for increased opportunities for supportive parenting. Importantly, increased material resources are also linked with decreases in adverse experience exposure, emphasizing positive impacts on child development across domains.},
	urldate = {2025-10-13},
	journal = {JAMA Pediatrics},
	author = {Herzberg, Max P. and Villanueva, Nancy J. and Barch, Deanna M. and Luby, Joan L.},
	month = oct,
	year = {2025},
	file = {Full Text PDF:/Users/mh15694/Zotero/storage/N7SSMNFI/Herzberg et al. - 2025 - Resource Thresholds for Parenting to Enhance Child Cognition.pdf:application/pdf;Snapshot:/Users/mh15694/Zotero/storage/6V3SUDNG/jamapediatrics.2025.html:text/html},
}

@article{steinhoff_childhood_2025,
	title = {Childhood behavioral inhibition and overcontrol: {Risk} for psychiatric and peer outcomes},
	issn = {1939-0599},
	shorttitle = {Childhood behavioral inhibition and overcontrol},
	doi = {10.1037/dev0002042},
	abstract = {Behavioral inhibition (BI), a temperamental trait; the error-related negativity (ERN), a marker of performance monitoring measured via electroencephalogram; and overcontrol, a phenotype characterized by perfectionism and inflexibility, all show associations with childhood anxiety, obsessive–compulsive symptoms, and social functioning. However, the independent and combined risk for psychiatric and social functioning of these factors is unknown. The present study examined how childhood BI, ERN, and overcontrol independently predict longitudinal psychiatric symptoms and peer functioning. We then examined how overcontrol may mediate the relationship between BI and longitudinal outcomes, as well as how the ERN may moderate this mediation. Caregivers completed baseline (aged 5–6 years; 48\% female; 77\% White) measures of BI, overcontrol, and psychiatric and peer functioning (N = 123), and children completed a go/no-go task while an electroencephalogram was collected (n = 86). Two years later, parents completed measures of psychiatric symptoms and peer functioning. Findings demonstrated only overcontrol, not BI or ERN, predicted worsening anxiety and peer relations. Overcontrol mediated the relationship between BI and longitudinal anxiety and between BI and longitudinal peer functioning. The ERN did not moderate these mediations. Findings suggest overcontrol confers risk for worsening childhood psychiatric and peer outcomes and may be an understudied mechanism linking BI to these outcomes. Therefore, early identification of the overcontrolled phenotype may be important given its direct association with an exacerbation of psychiatric and peer functioning difficulties across a 2-year period. Moreover, overcontrol may be a clinically useful and potent target for childhood psychiatric and social problems. (PsycInfo Database Record (c) 2025 APA, all rights reserved)},
	journal = {Developmental Psychology},
	publisher = {American Psychological Association},
	author = {Steinhoff, Molly Fennig and Sudit, Ella and Fox, Nathan A. and Tillman, Rebecca and Herzberg, Max P. and Barch, Deanna M. and Luby, Joan L. and Gilbert, Kirsten},
	year = {2025},
	note = {Place: US},
	keywords = {Peers, Behavioral Inhibition, At Risk Populations, Childhood Development, Child Psychopathology, Error-Related Negativity, Psychiatric Symptoms, Social Functioning},
	file = {Full Text PDF:/Users/mh15694/Zotero/storage/U6DHID65/Steinhoff et al. - 2025 - Childhood behavioral inhibition and overcontrol Risk for psychiatric and peer outcomes.pdf:application/pdf},
}
